APP_ENV=local
HOST=127.0.0.1
PORT=8080
DATABASE_URL=sqlite://data/agent_foundry.db
PDF_EXTRACT_COMMAND=backend/python/.venv/bin/agent-foundry-extract-pdf
MACRO_ANALYSIS_COMMAND=backend/python/.venv/bin/agent-foundry-macro-analysis
HERMES_CRON_JOBS_PATH=data/hermes-cron/jobs.json
STRUCTURED_PRODUCTS_ENRICHMENT_ENABLED=true
STRUCTURED_PRODUCTS_ENRICHMENT_COMMAND=uv
STRUCTURED_PRODUCTS_ENRICHMENT_WORKDIR=backend/python
STRUCTURED_PRODUCTS_ENRICHMENT_JSON=data/structured-products-enrichment.json
STRUCTURED_PRODUCTS_RISK_JSON=data/structured-products-risk.json
STRUCTURED_PRODUCTS_ENRICHMENT_CSV=data/structured-products-enrichment.csv
STRUCTURED_PRODUCTS_ENRICHMENT_DB=data/structured-products-enrichment.sqlite3
STRUCTURED_PRODUCTS_ENRICHMENT_NO_LIVE=false
STRUCTURED_PRODUCTS_EXPORT_FILES=false
STRUCTURED_PRODUCTS_AUTO_REFRESH_ENABLED=true
STRUCTURED_PRODUCTS_AUTO_REFRESH_INTERVAL_MINS=60
STRUCTURED_PRODUCTS_MARKET_OPEN_HOUR_CET=8
STRUCTURED_PRODUCTS_MARKET_CLOSE_HOUR_CET=22
# Background underlying quotes + all-holdings data-quality snapshots, in the Rust service.
PORTFOLIO_MONITOR_ENABLED=true
PORTFOLIO_MONITOR_INTERVAL_SECONDS=300
# Hourly snapshots older than this are deleted (7-3650 days).
PORTFOLIO_MONITOR_RETENTION_DAYS=30
FX_RATES_ENABLED=true
FRANKFURTER_USD_LATEST_URL=https://api.frankfurter.dev/v1/latest?base=USD
FX_RATE_CACHE_TTL_SECONDS=3600
ALPACA_MARKET_DATA_ENABLED=true
ALPACA_MAX_SYMBOLS_PER_REQUEST=20
ALPACA_QUOTE_CACHE_TTL_SECONDS=60
ALPACA_USD_EUR_RATE=0.92
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

# FRED API (Macroeconomic data for US stocks)
# Get a key from https://fred.stlouisfed.org/docs/api/fred/
# FRED_API_KEY=
FRED_CACHE_TTL_SECONDS=86400

# FinCal API (Market calendar — XETRA trading days)
# Free key from https://fincalapi.com/dashboard/login
# FINCAL_API_KEY=
FRED_FALLBACK_CACHE_TTL_SECONDS=600
FRED_REQUEST_DELAY_MS=350
FRED_MAX_RETRIES=2
FRED_RETRY_BASE_DELAY_MS=1000

RUST_LOG=agent_foundry_backend=info,tower_http=info
