[Unit]
Description=Refresh Agent-Foundry Hermes cron status data
Documentation=file:/opt/agent-foundry/web/scripts/generateHermesCronData.js
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agentfoundry
Group=agentfoundry
WorkingDirectory=/opt/agent-foundry/web
Environment="HOME=/opt/agent-foundry"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/npm run generate:cron
