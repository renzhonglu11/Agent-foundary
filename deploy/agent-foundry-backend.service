[Unit]
Description=Agent Foundry Rust backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rz
Group=rz
WorkingDirectory=/home/rz/Agent-Foundry
EnvironmentFile=/home/rz/Agent-Foundry/.env
Environment=PATH=/home/rz/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/rz/Agent-Foundry/bin/agent-foundry-backend
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/rz/Agent-Foundry/data

[Install]
WantedBy=multi-user.target
