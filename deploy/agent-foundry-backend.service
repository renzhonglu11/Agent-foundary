[Unit]
Description=Agent Foundry Rust backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rz
Group=rz
WorkingDirectory=/home/rz/Agent-Foundry/shared
EnvironmentFile=/home/rz/Agent-Foundry/shared/.env
EnvironmentFile=/home/rz/Agent-Foundry/current/runtime.env
Environment=PATH=/home/rz/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/rz/Agent-Foundry/current/bin/agent-foundry-backend
Restart=on-failure
RestartSec=5
# The product scraper runs a headless browser inside this unit. Keep it from
# exhausting the host, and keep the API alive when the kernel kills a scraper
# process: the default policy stops the whole unit, which then restarts and
# scrapes again.
MemoryMax=3G
OOMPolicy=continue
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/rz/Agent-Foundry/shared

[Install]
WantedBy=multi-user.target
